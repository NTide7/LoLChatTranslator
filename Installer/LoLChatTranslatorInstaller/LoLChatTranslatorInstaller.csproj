<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\..\LoLChatTranslator\Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>LoLChatTranslatorSetup</AssemblyName>
    <RootNamespace>LoLChatTranslatorInstaller</RootNamespace>
    <Product>LOL Chat OCR Translator Installer</Product>
    <AssemblyTitle>LOL Chat OCR Translator Installer</AssemblyTitle>
    <Company>LoLChatTranslator</Company>
    <Authors>LoLChatTranslator</Authors>
    <Version>1.0.1-dev</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <InformationalVersion>1.0.1-dev</InformationalVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>zh-Hans;zh-Hant;ja;ko;vi</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions>.xml</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\LoLChatTranslator\Assets\AppIcon.ico" Link="AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Payload.zip" LogicalName="Payload.zip" Condition="Exists('Payload.zip')" />
  </ItemGroup>

</Project>
