<Window x:Class="LoLChatTranslator.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本"
        Icon="Assets/AppIcon.ico"
        Width="420"
        Height="180"
        MinWidth="380"
        MinHeight="160"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F6F8">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageTextBlock"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   FontSize="15"
                   Foreground="#111827" />

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="取消"
                    MinWidth="90"
                    MinHeight="34"
                    Padding="14,5"
                    Margin="0,0,10,0"
                    Background="#DC2626"
                    Foreground="White"
                    BorderThickness="0"
                    Click="CancelButton_Click" />
            <Button Content="更新"
                    MinWidth="90"
                    MinHeight="34"
                    Padding="14,5"
                    Background="#059669"
                    Foreground="White"
                    BorderThickness="0"
                    Click="UpdateButton_Click" />
        </StackPanel>
    </Grid>
</Window>
