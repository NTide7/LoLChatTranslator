<Window x:Class="LoLChatTranslator.HotkeyCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置快捷键"
        Icon="Assets/AppIcon.ico"
        Height="180"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F6F8"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="请直接按下新的快捷键"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#111827" />
        <TextBlock x:Name="HintTextBlock"
                   Grid.Row="1"
                   Text="支持 F1-F24，或 Ctrl / Alt / Shift 组合键。按 Esc 取消。"
                   Margin="0,16,0,0"
                   TextWrapping="Wrap"
                   Foreground="#6B7280" />
        <Button Grid.Row="2"
                Content="取消"
                Width="88"
                HorizontalAlignment="Right"
                Click="CancelButton_Click" />
    </Grid>
</Window>
