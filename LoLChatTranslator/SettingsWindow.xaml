<Window x:Class="LoLChatTranslator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LOL Chat OCR Translator 设置"
        Icon="Assets/AppIcon.ico"
        Height="680"
        Width="720"
        MinHeight="620"
        MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="180" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#111827" />
        </Style>
        <Style x:Key="FormRowStyle" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="ReadonlyHotkeyStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Background" Value="#F9FAFB" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style x:Key="ColorPickerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="34" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ToolTip" Value="打开色盘" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="5">
                            <Grid Width="22" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="12" Height="12" Fill="#EF4444" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <Ellipse Width="12" Height="12" Fill="#22C55E" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                <Ellipse Width="12" Height="12" Fill="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="18">
        <Grid DockPanel.Dock="Bottom"
              Margin="0,16,0,0">
            <Button Content="恢复默认"
                    x:Name="RestoreDefaultButton"
                    HorizontalAlignment="Left"
                    Margin="0"
                    Background="#DC2626"
                    Foreground="White"
                    BorderThickness="0"
                    Click="RestoreDefaultButton_Click" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="取消"
                        Click="CancelButton_Click" />
                <Button x:Name="ApplyButton"
                        Content="应用"
                        Background="#059669"
                        Foreground="White"
                        BorderThickness="0"
                        Click="ApplyButton_Click" />
                <Button x:Name="SaveButton"
                        Content="保存"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
        <TabControl Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">
            <TabItem x:Name="OcrTabItem" Header="OCR 设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock Text="当前聊天区域" Style="{StaticResource FormLabelStyle}" />
                            <TextBlock x:Name="RegionSummaryTextBlock"
                                       VerticalAlignment="Center"
                                       Foreground="#374151"
                                       TextWrapping="Wrap" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="180,0,0,12">
                            <Button Content="查看当前"
                                    Background="#0F766E"
                                    Foreground="White"
                                    Click="ViewCurrentRegionButton_Click" />
                            <Button Content="重新框选"
                                    Background="#0891B2"
                                    Foreground="White"
                                    Click="ReselectRegionButton_Click" />
                        </StackPanel>
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock Text="自动识别速度" Style="{StaticResource FormLabelStyle}" />
                            <ComboBox x:Name="AutoOcrSpeedComboBox"
                                      Width="280">
                                <ComboBoxItem Content="稳定" Tag="stable" />
                                <ComboBoxItem Content="均衡" Tag="balanced" />
                                <ComboBoxItem Content="快速" Tag="fast" />
                            </ComboBox>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock Text="OCR 引擎" Style="{StaticResource FormLabelStyle}" />
                            <ComboBox x:Name="OcrEngineComboBox"
                                      Width="280">
                                <ComboBoxItem Content="Windows OCR" Tag="WindowsOCR" />
                                <ComboBoxItem Content="PP-OCRv5 多语言版" Tag="PPOCRv5Multilingual" />
                            </ComboBox>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock x:Name="OcrLanguageLabel" Text="识别语言" Style="{StaticResource FormLabelStyle}" />
                            <ComboBox x:Name="OcrLanguageComboBox" Width="280">
                                <ComboBoxItem Content="自动" Tag="auto" />
                                <ComboBoxItem Content="中文 + 英文" Tag="ch" />
                                <ComboBoxItem Content="英文" Tag="en" />
                                <ComboBoxItem Content="日文" Tag="japan" />
                            </ComboBox>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock Text="截图间隔（ms）" Style="{StaticResource FormLabelStyle}" />
                            <TextBox x:Name="CaptureIntervalTextBox" Width="280" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock Text="OCR 环境位置" Style="{StaticResource FormLabelStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="OcrEnvironmentDirectoryTextBox" Width="280" />
                                <Button x:Name="BrowseOcrEnvironmentDirectoryButton"
                                        Content="浏览..."
                                        Margin="8,0,0,0"
                                        Padding="12,2"
                                        Click="BrowseOcrEnvironmentDirectoryButton_Click" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="172,8,0,0">
                            <Button x:Name="InstallOcrDependenciesButton"
                                    Content="检测/安装 PP-OCRv5 OCR 环境"
                                    Background="#7C3AED"
                                    Foreground="White"
                                    Click="InstallOcrDependenciesButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="OcrDependencyStatusTextBlock"
                                   Margin="180,10,0,0"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap"
                                   Text="点击按钮会检测 Python，在程序所在 LoLChatTranslator 文件夹创建项目专用 PP-OCRv5 OCR 虚拟环境，并安装 paddlepaddle 与 paddleocr 3.x，不会写入用户全局 Python。" />
                        <StackPanel x:Name="OcrInstallProgressPanel"
                                    Visibility="Collapsed"
                                    Margin="180,10,0,0">
                            <ProgressBar x:Name="OcrInstallProgressBar"
                                         Minimum="0"
                                         Maximum="100"
                                         Height="10"
                                         Value="0" />
                            <TextBox x:Name="OcrInstallConsoleTextBox"
                                     Margin="0,8,0,0"
                                     Height="150"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     IsReadOnly="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Background="#111827"
                                     Foreground="#E5E7EB"
                                     BorderBrush="#374151" />
                        </StackPanel>
                        <Expander x:Name="AdvancedOcrSettingsExpander"
                                  Header="高级设置"
                                  Margin="0,18,0,0"
                                  IsExpanded="False">
                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Margin="180,0,0,12"
                                           Foreground="#B45309"
                                           TextWrapping="Wrap"
                                           Text="实验功能可能漏识别多行聊天，不推荐普通用户开启。" />
                                <CheckBox x:Name="DiagnosticModeCheckBox"
                                          Content="诊断模式：保存详细日志和调试图片"
                                          Margin="180,0,0,12" />
                                <DockPanel Style="{StaticResource FormRowStyle}">
                                    <TextBlock x:Name="OcrModeLabel" Text="OCR 模式" Style="{StaticResource FormLabelStyle}" />
                                    <ComboBox x:Name="OcrModeComboBox">
                                        <ComboBoxItem Content="稳定模式" Tag="stable" />
                                        <ComboBoxItem Content="快速模式" Tag="fast" />
                                        <ComboBoxItem Content="高精度模式" Tag="accurate" />
                                        <ComboBoxItem Content="实验模式" Tag="experimental" />
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel Style="{StaticResource FormRowStyle}">
                                    <TextBlock Text="更多识别语言" Style="{StaticResource FormLabelStyle}" />
                                    <ComboBox x:Name="AdvancedOcrLanguageComboBox" Width="280">
                                        <ComboBoxItem Content="自动" Tag="auto" />
                                        <ComboBoxItem Content="Chinese 中文+英文+日文" Tag="ch" />
                                        <ComboBoxItem Content="English 英文" Tag="en" />
                                        <ComboBoxItem Content="Latin 拉丁语系" Tag="latin" />
                                        <ComboBoxItem Content="Korean 韩语" Tag="korean" />
                                        <ComboBoxItem Content="Japanese 日语" Tag="japan" />
                                        <ComboBoxItem Content="Traditional Chinese 繁体中文" Tag="traditional_chinese" />
                                        <ComboBoxItem Content="Russian / East Slavic 俄语/东斯拉夫语系" Tag="eslav" />
                                        <ComboBoxItem Content="Cyrillic 西里尔语系" Tag="cyrillic" />
                                        <ComboBoxItem Content="Thai 泰语" Tag="th" />
                                        <ComboBoxItem Content="Arabic 阿拉伯语系" Tag="arabic" />
                                        <ComboBoxItem Content="Devanagari 天城文" Tag="devanagari" />
                                        <ComboBoxItem Content="Tamil 泰米尔语" Tag="ta" />
                                        <ComboBoxItem Content="Telugu 泰卢固语" Tag="te" />
                                    </ComboBox>
                                </DockPanel>
                                <CheckBox x:Name="EnableRealtimeLowLatencyModeCheckBox"
                                          Content="低延迟触发（不改变 OCR 区域）"
                                          Margin="180,0,0,12" />
                                <CheckBox x:Name="EnableAdaptiveDirtyRegionOcrCheckBox"
                                          Content="实验：局部 dirty OCR，可能漏识别多行聊天"
                                          Margin="180,0,0,12" />
                                <CheckBox x:Name="EnableTextMaskDetectionCheckBox"
                                          Content="实验：text mask 变化触发"
                                          Margin="180,0,0,12" />
                                <CheckBox x:Name="EnableFixedBottomOcrCheckBox"
                                          Content="实验：固定底部 OCR"
                                          Margin="180,0,0,12" />
                                <CheckBox x:Name="SaveOcrDebugImagesCheckBox"
                                          Content="保存 OCR 调试图片"
                                          Margin="180,0,0,12" />
                                <CheckBox x:Name="ShowOriginalBeforeTranslationCheckBox"
                                          Content="兼容保留：当前不改变显示行为"
                                          Margin="180,0,0,12" />
                                <CheckBox x:Name="EnableLineDeduplicationCheckBox"
                                          Content="启用行级去重"
                                          Margin="180,0,0,12" />
                                <DockPanel Style="{StaticResource FormRowStyle}">
                                    <TextBlock Text="完整校准间隔（ms）" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox x:Name="FullRescanIntervalTextBox" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource FormRowStyle}">
                                    <TextBlock Text="dirty 区域阈值" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox x:Name="MaxDirtyRegionRatioTextBox" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource FormRowStyle}">
                                    <TextBlock Text="dirty padding X/Y" Style="{StaticResource FormLabelStyle}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="DirtyRegionPaddingXTextBox" Width="80" />
                                        <TextBlock Text=" / " VerticalAlignment="Center" Margin="6,0" />
                                        <TextBox x:Name="DirtyRegionPaddingYTextBox" Width="80" />
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Style="{StaticResource FormRowStyle}">
                                    <TextBlock Text="dirty batch 行数" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox x:Name="DirtyLineBatchSizeTextBox" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource FormRowStyle}">
                                    <TextBlock Text="图片放大倍率" Style="{StaticResource FormLabelStyle}" />
                                    <ComboBox x:Name="ImageScaleComboBox">
                                        <ComboBoxItem Content="原图" Tag="1" />
                                        <ComboBoxItem Content="2x" Tag="2" />
                                        <ComboBoxItem Content="3x" Tag="3" />
                                        <ComboBoxItem Content="4x" Tag="4" />
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel Style="{StaticResource FormRowStyle}">
                                    <TextBlock Text="对比度" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox x:Name="ContrastTextBox" />
                                </DockPanel>
                                <CheckBox x:Name="EnableSharpenCheckBox"
                                          Content="启用轻微锐化"
                                          Margin="180,0,0,12" />
                                <DockPanel Style="{StaticResource FormRowStyle}">
                                    <TextBlock Text="最低置信度" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox x:Name="MinConfidenceTextBox" />
                                </DockPanel>
                                <Button Content="打开频道别名文件"
                                        HorizontalAlignment="Left"
                                        Margin="180,8,0,0"
                                        Click="OpenChannelAliasesButton_Click" />
                                <TextBlock Margin="180,8,0,0"
                                           Foreground="#6B7280"
                                           TextWrapping="Wrap"
                                           Text="频道识别支持多语言别名。高级用户可以编辑 Resources/chat_channel_aliases.json 来添加更多语言或 OCR 误识别别名。" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="TranslateTabItem" Header="翻译设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock x:Name="SourceLanguageLabel" Text="源语言" Style="{StaticResource FormLabelStyle}" />
                            <ComboBox x:Name="SourceLanguageComboBox"
                                      SelectionChanged="LanguageComboBox_SelectionChanged">
                                <ComboBoxItem Content="自动检测" Tag="auto" />
                                <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
                                <ComboBoxItem Content="繁體中文" Tag="zh-Hant" />
                                <ComboBoxItem Content="English" Tag="en" />
                                <ComboBoxItem Content="한국어" Tag="ko" />
                                <ComboBoxItem Content="日本語" Tag="ja" />
                                <ComboBoxItem Content="Tiếng Việt" Tag="vi" />
                            </ComboBox>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock x:Name="TargetLanguageLabel" Text="目标语言" Style="{StaticResource FormLabelStyle}" />
                            <ComboBox x:Name="TargetLanguageComboBox"
                                      SelectionChanged="LanguageComboBox_SelectionChanged">
                                <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
                                <ComboBoxItem Content="繁體中文" Tag="zh-Hant" />
                                <ComboBoxItem Content="English" Tag="en" />
                                <ComboBoxItem Content="한국어" Tag="ko" />
                                <ComboBoxItem Content="日本語" Tag="ja" />
                                <ComboBoxItem Content="Tiếng Việt" Tag="vi" />
                            </ComboBox>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock x:Name="TranslateServiceLabel" Text="翻译服务" Style="{StaticResource FormLabelStyle}" />
                            <ComboBox x:Name="TranslateEngineComboBox"
                                      SelectionChanged="TranslateEngineComboBox_SelectionChanged">
                                <ComboBoxItem Content="MyMemory免费翻译" Tag="MyMemory免费翻译" />
                                <ComboBoxItem Content="AI API" Tag="AiApi" />
                                <ComboBoxItem Content="Ollama 本地模型" Tag="Ollama" />
                            </ComboBox>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock x:Name="ToxicDisplayModeLabel" Text="毒性内容显示" Style="{StaticResource FormLabelStyle}" />
                            <ComboBox x:Name="ToxicDisplayModeComboBox">
                                <ComboBoxItem Content="安全标签，推荐" Tag="label" />
                                <ComboBoxItem Content="显示原意，可能显示辱骂内容" Tag="literal" />
                                <ComboBoxItem Content="显示原始 OCR 文本" Tag="source" />
                                <ComboBoxItem Content="仅显示辱骂提示" Tag="hide" />
                            </ComboBox>
                        </DockPanel>
                        <CheckBox x:Name="EnableOverlayInputCheckBox"
                                  Content="为悬浮窗开启输入框"
                                  Margin="180,0,0,12"
                                  Checked="DisplayPreviewControl_Changed"
                                  Unchecked="DisplayPreviewControl_Changed" />
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock x:Name="OverlayInputTargetLanguageLabel"
                                       Text="悬浮窗输入输出语言"
                                       Style="{StaticResource FormLabelStyle}" />
                            <ComboBox x:Name="OverlayInputTargetLanguageComboBox">
                                <ComboBoxItem Content="跟随 OCR 反向" Tag="ocr-reverse" />
                                <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
                                <ComboBoxItem Content="繁體中文" Tag="zh-Hant" />
                                <ComboBoxItem Content="English" Tag="en" />
                                <ComboBoxItem Content="한국어" Tag="ko" />
                                <ComboBoxItem Content="日本語" Tag="ja" />
                                <ComboBoxItem Content="Tiếng Việt" Tag="vi" />
                            </ComboBox>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock x:Name="OverlayInputDefaultTargetLanguageLabel"
                                       Text="自动失败默认语言"
                                       Style="{StaticResource FormLabelStyle}" />
                            <ComboBox x:Name="OverlayInputDefaultTargetLanguageComboBox">
                                <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
                                <ComboBoxItem Content="繁體中文" Tag="zh-Hant" />
                                <ComboBoxItem Content="English" Tag="en" />
                                <ComboBoxItem Content="한국어" Tag="ko" />
                                <ComboBoxItem Content="日本語" Tag="ja" />
                                <ComboBoxItem Content="Tiếng Việt" Tag="vi" />
                            </ComboBox>
                        </DockPanel>
                        <StackPanel x:Name="AiTranslatorSettingsPanel">
                            <DockPanel Style="{StaticResource FormRowStyle}">
                                <TextBlock x:Name="ApiBaseLabel" Text="API Base" Style="{StaticResource FormLabelStyle}" />
                                <TextBox x:Name="ApiBaseTextBox" />
                            </DockPanel>
                            <DockPanel x:Name="ApiKeyRow" Style="{StaticResource FormRowStyle}">
                                <TextBlock x:Name="ApiKeyLabel" Text="API Key" Style="{StaticResource FormLabelStyle}" />
                                <PasswordBox x:Name="ApiKeyPasswordBox" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource FormRowStyle}">
                                <TextBlock x:Name="ModelLabel" Text="Model" Style="{StaticResource FormLabelStyle}" />
                                <TextBox x:Name="ModelTextBox" />
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="172,0,0,12">
                                <Button x:Name="TestTranslationButton"
                                        Content="测试连接/测试翻译"
                                        Click="TestTranslationButton_Click" />
                                <TextBlock x:Name="TestTranslationStatusTextBlock"
                                           VerticalAlignment="Center"
                                           Foreground="#6B7280"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="MyMemoryTranslatorNoticeTextBlock"
                                   Text="MyMemory 不需要 API Key，支持简体中文、繁體中文、English、한국어、日本語、Tiếng Việt 之间互译；源语言为自动检测时会按文本特征做轻量判断。"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap"
                                   Margin="180,0,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="FilterTabItem" Header="过滤设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <CheckBox x:Name="RemoveUsernameCheckBox"
                                  Content="翻译输入去掉用户名（不影响悬浮窗标题）"
                                  Margin="0,0,0,12" />
                        <CheckBox x:Name="RemoveChannelTagCheckBox"
                                  Content="悬浮窗隐藏频道标签"
                                  Margin="0,0,0,12" />
                        <CheckBox x:Name="FilterSystemMessagesCheckBox"
                                  Content="过滤系统消息"
                                  Margin="0,0,0,12" />
                        <CheckBox x:Name="FilterPingMessagesCheckBox"
                                  Content="过滤 ping 消息"
                                  Margin="0,0,0,12" />
                        <CheckBox x:Name="FilterKillMessagesCheckBox"
                                  Content="过滤击杀提示"
                                  Margin="0,0,0,12" />
                        <CheckBox x:Name="FilterPurchaseMessagesCheckBox"
                                  Content="过滤购买提示"
                                  Margin="0,0,0,12" />
                        <CheckBox x:Name="ExcludePlayersEnabledCheckBox"
                                  Content="排除玩家"
                                  Margin="0,4,0,8"
                                  Checked="ExcludePlayersEnabledCheckBox_Changed"
                                  Unchecked="ExcludePlayersEnabledCheckBox_Changed" />
                        <StackPanel x:Name="ExcludedPlayersPanel"
                                    Margin="22,0,0,12"
                                    Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,8">
                                <Button x:Name="AddExcludedPlayerButton"
                                        Content="新增玩家"
                                        Margin="0"
                                        Click="AddExcludedPlayerButton_Click" />
                                <TextBlock x:Name="ExcludedPlayersStatusTextBlock"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#6B7280"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Border x:Name="AddExcludedPlayerPanel"
                                    Visibility="Collapsed"
                                    Margin="0,0,0,10"
                                    Padding="10"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Background="#F9FAFB">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock x:Name="ExcludedPlayerNameLabel"
                                                   Width="88"
                                                   VerticalAlignment="Center"
                                                   Text="玩家名称" />
                                        <TextBox x:Name="ExcludedPlayerNameTextBox" />
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock x:Name="ExcludedPlayerTagLabel"
                                                   Width="88"
                                                   VerticalAlignment="Center"
                                                   Text="玩家编号" />
                                        <TextBox x:Name="ExcludedPlayerTagTextBox" />
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <Button x:Name="CancelAddExcludedPlayerButton"
                                                Content="取消"
                                                Click="CancelAddExcludedPlayerButton_Click" />
                                        <Button x:Name="ConfirmAddExcludedPlayerButton"
                                                Content="添加"
                                                Background="#2563EB"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Click="ConfirmAddExcludedPlayerButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <ItemsControl x:Name="ExcludedPlayersItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,6"
                                                   LastChildFill="True">
                                            <Button DockPanel.Dock="Right"
                                                    Content="🗑"
                                                    Width="36"
                                                    MinHeight="28"
                                                    Padding="0"
                                                    Margin="8,0,0,0"
                                                    Background="#DC2626"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    ToolTip="删除"
                                                    Tag="{Binding}"
                                                    Click="RemoveExcludedPlayerButton_Click" />
                                            <Border Background="#F3F4F6"
                                                    BorderBrush="#E5E7EB"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="8,5">
                                                <TextBlock Text="{Binding RiotId}"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="DisplayTabItem" Header="显示设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock x:Name="UiLanguageLabel" Text="界面语言" Style="{StaticResource FormLabelStyle}" />
                            <ComboBox x:Name="UiLanguageComboBox"
                                      SelectionChanged="UiLanguageComboBox_SelectionChanged">
                                <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
                                <ComboBoxItem Content="繁體中文" Tag="zh-Hant" />
                                <ComboBoxItem Content="English" Tag="en" />
                                <ComboBoxItem Content="한국어" Tag="ko" />
                                <ComboBoxItem Content="日本語" Tag="ja" />
                                <ComboBoxItem Content="Tiếng Việt" Tag="vi" />
                            </ComboBox>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock Text="悬浮窗透明度" Style="{StaticResource FormLabelStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="OpacitySlider"
                                        Width="260"
                                        Minimum="0.2"
                                        Maximum="1"
                                        TickFrequency="0.05"
                                        PreviewMouseLeftButtonDown="SliderJumpToPoint_PreviewMouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="SliderJumpToPoint_PreviewMouseLeftButtonUp"
                                        PreviewMouseMove="SliderJumpToPoint_PreviewMouseMove"
                                        ValueChanged="DisplayPreviewControl_Changed" />
                                <TextBlock Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:F2}}"
                                           Width="48"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock Text="字体大小" Style="{StaticResource FormLabelStyle}" />
                            <TextBox x:Name="FontSizeTextBox"
                                     TextChanged="DisplayPreviewControl_Changed" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock Text="最大显示行数" Style="{StaticResource FormLabelStyle}" />
                            <TextBox x:Name="MaxLinesTextBox"
                                     TextChanged="DisplayPreviewControl_Changed" />
                        </DockPanel>
                        <CheckBox x:Name="ShowSenderNameCheckBox"
                                  Content="悬浮窗显示发言人"
                                  Margin="0,4,0,12"
                                  Checked="DisplayPreviewControl_Changed"
                                  Unchecked="DisplayPreviewControl_Changed" />
                        <CheckBox x:Name="AlwaysOnTopCheckBox"
                                  Content="总是置顶"
                                  Margin="0,4,0,12"
                                  Checked="DisplayPreviewControl_Changed"
                                  Unchecked="DisplayPreviewControl_Changed" />
                        <CheckBox x:Name="ClickThroughCheckBox"
                                  Content="鼠标穿透"
                                  Margin="0,0,0,12"
                                  Checked="DisplayPreviewControl_Changed"
                                  Unchecked="DisplayPreviewControl_Changed" />
                        <CheckBox x:Name="ExcludeFromScreenCaptureCheckBox"
                                  Content="截图时排除悬浮窗"
                                  Margin="0,0,0,6"
                                  Checked="DisplayPreviewControl_Changed"
                                  Unchecked="DisplayPreviewControl_Changed" />
                        <TextBlock Text="开启后会优先使用 Windows 窗口捕获排除，失败时仅在悬浮窗覆盖 OCR 区域时临时隐藏。"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap"
                                   Margin="22,0,0,12" />
                        <CheckBox x:Name="HideOverlayDuringCaptureCheckBox"
                                  Content="捕获时隐藏悬浮窗"
                                  Margin="0,0,0,6"
                                  Checked="DisplayPreviewControl_Changed"
                                  Unchecked="DisplayPreviewControl_Changed" />
                        <TextBlock Text="避免 OCR 识别到本程序自己的翻译结果；关闭后仅用于调试。"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap"
                                   Margin="22,0,0,12" />
                        <TextBlock Text="悬浮窗颜色（十六进制）"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="0,8,0,12" />
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock Text="悬浮窗背景" Style="{StaticResource FormLabelStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="OverlayBackgroundColorTextBox"
                                         Width="118"
                                         TextChanged="DisplayPreviewControl_Changed" />
                                <Button Tag="OverlayBackgroundColorTextBox"
                                        Style="{StaticResource ColorPickerButtonStyle}"
                                        Click="PickColorButton_Click" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock Text="输入框背景" Style="{StaticResource FormLabelStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="OverlayInputBackgroundColorTextBox"
                                         Width="118"
                                         TextChanged="DisplayPreviewControl_Changed" />
                                <Button Tag="OverlayInputBackgroundColorTextBox"
                                        Style="{StaticResource ColorPickerButtonStyle}"
                                        Click="PickColorButton_Click" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="频道颜色（十六进制）"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="0,8,0,12" />
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock Text="队伍" Style="{StaticResource FormLabelStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="TeamHeaderColorTextBox"
                                         Width="118"
                                         TextChanged="DisplayPreviewControl_Changed" />
                                <Button Tag="TeamHeaderColorTextBox"
                                        Style="{StaticResource ColorPickerButtonStyle}"
                                        Click="PickColorButton_Click" />
                                <TextBlock Text="正文"
                                   Margin="12,0,8,0"
                                   VerticalAlignment="Center" />
                                <TextBox x:Name="TeamTextColorTextBox"
                                         Width="118"
                                         TextChanged="DisplayPreviewControl_Changed" />
                                <Button Tag="TeamTextColorTextBox"
                                        Style="{StaticResource ColorPickerButtonStyle}"
                                        Click="PickColorButton_Click" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock Text="所有人" Style="{StaticResource FormLabelStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="AllHeaderColorTextBox"
                                         Width="118"
                                         TextChanged="DisplayPreviewControl_Changed" />
                                <Button Tag="AllHeaderColorTextBox"
                                        Style="{StaticResource ColorPickerButtonStyle}"
                                        Click="PickColorButton_Click" />
                                <TextBlock Text="正文"
                                           Margin="12,0,8,0"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="AllTextColorTextBox"
                                         Width="118"
                                         TextChanged="DisplayPreviewControl_Changed" />
                                <Button Tag="AllTextColorTextBox"
                                        Style="{StaticResource ColorPickerButtonStyle}"
                                        Click="PickColorButton_Click" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock Text="小队" Style="{StaticResource FormLabelStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="PartyHeaderColorTextBox"
                                         Width="118"
                                         TextChanged="DisplayPreviewControl_Changed" />
                                <Button Tag="PartyHeaderColorTextBox"
                                        Style="{StaticResource ColorPickerButtonStyle}"
                                        Click="PickColorButton_Click" />
                                <TextBlock Text="正文"
                                           Margin="12,0,8,0"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="PartyTextColorTextBox"
                                         Width="118"
                                         TextChanged="DisplayPreviewControl_Changed" />
                                <Button Tag="PartyTextColorTextBox"
                                        Style="{StaticResource ColorPickerButtonStyle}"
                                        Click="PickColorButton_Click" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock Text="未知" Style="{StaticResource FormLabelStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="UnknownHeaderColorTextBox"
                                         Width="118"
                                         TextChanged="DisplayPreviewControl_Changed" />
                                <Button Tag="UnknownHeaderColorTextBox"
                                        Style="{StaticResource ColorPickerButtonStyle}"
                                        Click="PickColorButton_Click" />
                                <TextBlock Text="正文"
                                           Margin="12,0,8,0"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="UnknownTextColorTextBox"
                                         Width="118"
                                         TextChanged="DisplayPreviewControl_Changed" />
                                <Button Tag="UnknownTextColorTextBox"
                                        Style="{StaticResource ColorPickerButtonStyle}"
                                        Click="PickColorButton_Click" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock Text="系统" Style="{StaticResource FormLabelStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="SystemHeaderColorTextBox"
                                         Width="118"
                                         TextChanged="DisplayPreviewControl_Changed" />
                                <Button Tag="SystemHeaderColorTextBox"
                                        Style="{StaticResource ColorPickerButtonStyle}"
                                        Click="PickColorButton_Click" />
                                <TextBlock Text="正文"
                                           Margin="12,0,8,0"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="SystemTextColorTextBox"
                                         Width="118"
                                         TextChanged="DisplayPreviewControl_Changed" />
                                <Button Tag="SystemTextColorTextBox"
                                        Style="{StaticResource ColorPickerButtonStyle}"
                                        Click="PickColorButton_Click" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="左侧输入频道标题颜色，右侧输入译文颜色，颜色为十六进制。"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap"
                                   Margin="180,0,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="HotkeyTabItem" Header="快捷键设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock Text="手动翻译一次" Style="{StaticResource FormLabelStyle}" />
                            <Button Content="设置"
                                    DockPanel.Dock="Right"
                                    Click="SetManualTranslateHotkeyButton_Click" />
                            <Button Content="清空"
                                    DockPanel.Dock="Right"
                                    Tag="ManualTranslateHotkeyTextBox"
                                    Click="ClearHotkeyButton_Click" />
                            <TextBox x:Name="ManualTranslateHotkeyTextBox"
                                     Style="{StaticResource ReadonlyHotkeyStyle}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock Text="开启/关闭自动翻译" Style="{StaticResource FormLabelStyle}" />
                            <Button Content="设置"
                                    DockPanel.Dock="Right"
                                    Click="SetToggleAutoTranslateHotkeyButton_Click" />
                            <Button Content="清空"
                                    DockPanel.Dock="Right"
                                    Tag="ToggleAutoTranslateHotkeyTextBox"
                                    Click="ClearHotkeyButton_Click" />
                            <TextBox x:Name="ToggleAutoTranslateHotkeyTextBox"
                                     Style="{StaticResource ReadonlyHotkeyStyle}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock Text="翻译剪贴板内容" Style="{StaticResource FormLabelStyle}" />
                            <Button Content="设置"
                                    DockPanel.Dock="Right"
                                    Click="SetTranslateClipboardHotkeyButton_Click" />
                            <Button Content="清空"
                                    DockPanel.Dock="Right"
                                    Tag="TranslateClipboardHotkeyTextBox"
                                    Click="ClearHotkeyButton_Click" />
                            <TextBox x:Name="TranslateClipboardHotkeyTextBox"
                                     Style="{StaticResource ReadonlyHotkeyStyle}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock Text="打开设置窗口" Style="{StaticResource FormLabelStyle}" />
                            <Button Content="设置"
                                    DockPanel.Dock="Right"
                                    Click="SetOpenSettingsHotkeyButton_Click" />
                            <Button Content="清空"
                                    DockPanel.Dock="Right"
                                    Tag="OpenSettingsHotkeyTextBox"
                                    Click="ClearHotkeyButton_Click" />
                            <TextBox x:Name="OpenSettingsHotkeyTextBox"
                                     Style="{StaticResource ReadonlyHotkeyStyle}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock Text="重新框选聊天区域" Style="{StaticResource FormLabelStyle}" />
                            <Button Content="设置"
                                    DockPanel.Dock="Right"
                                    Click="SetReselectRegionHotkeyButton_Click" />
                            <Button Content="清空"
                                    DockPanel.Dock="Right"
                                    Tag="ReselectRegionHotkeyTextBox"
                                    Click="ClearHotkeyButton_Click" />
                            <TextBox x:Name="ReselectRegionHotkeyTextBox"
                                     Style="{StaticResource ReadonlyHotkeyStyle}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock Text="查看当前框选范围" Style="{StaticResource FormLabelStyle}" />
                            <Button Content="设置"
                                    DockPanel.Dock="Right"
                                    Click="SetPreviewRegionHotkeyButton_Click" />
                            <Button Content="清空"
                                    DockPanel.Dock="Right"
                                    Tag="PreviewRegionHotkeyTextBox"
                                    Click="ClearHotkeyButton_Click" />
                            <TextBox x:Name="PreviewRegionHotkeyTextBox"
                                     Style="{StaticResource ReadonlyHotkeyStyle}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock Text="显示/隐藏悬浮窗" Style="{StaticResource FormLabelStyle}" />
                            <Button Content="设置"
                                    DockPanel.Dock="Right"
                                    Click="SetToggleOverlayHotkeyButton_Click" />
                            <Button Content="清空"
                                    DockPanel.Dock="Right"
                                    Tag="ToggleOverlayHotkeyTextBox"
                                    Click="ClearHotkeyButton_Click" />
                            <TextBox x:Name="ToggleOverlayHotkeyTextBox"
                                     Style="{StaticResource ReadonlyHotkeyStyle}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock Text="聚焦悬浮窗输入框" Style="{StaticResource FormLabelStyle}" />
                            <Button Content="设置"
                                    DockPanel.Dock="Right"
                                    Click="SetFocusOverlayInputHotkeyButton_Click" />
                            <Button Content="清空"
                                    DockPanel.Dock="Right"
                                    Tag="FocusOverlayInputHotkeyTextBox"
                                    Click="ClearHotkeyButton_Click" />
                            <TextBox x:Name="FocusOverlayInputHotkeyTextBox"
                                     Style="{StaticResource ReadonlyHotkeyStyle}" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="AboutTabItem" Header="关于">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0"
                               Margin="0,0,0,14">
                        <TextBlock x:Name="ProjectLinkLabel"
                                   Text="项目链接"
                                   Style="{StaticResource FormLabelStyle}" />
                        <TextBlock VerticalAlignment="Center">
                            <Hyperlink x:Name="ProjectLinkHyperlink"
                                       NavigateUri="https://github.com/NTide7/LoLChatTranslator"
                                       RequestNavigate="ProjectLinkHyperlink_RequestNavigate">
                                https://github.com/NTide7/LoLChatTranslator
                            </Hyperlink>
                        </TextBlock>
                    </DockPanel>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="172,0,0,0">
                        <Button x:Name="CheckUpdatesButton"
                                Content="检查更新"
                                Click="CheckUpdatesButton_Click" />
                        <TextBlock x:Name="CheckUpdatesStatusTextBlock"
                                   VerticalAlignment="Center"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Margin="172,18,0,0">
                        <Button x:Name="DeleteOcrEnvironmentButton"
                                Content="删除 PP-OCRv5 OCR 环境"
                                HorizontalAlignment="Left"
                                Background="#DC2626"
                                Foreground="White"
                                BorderThickness="0"
                                Click="DeleteOcrEnvironmentButton_Click" />
                        <TextBlock x:Name="DeleteOcrEnvironmentStatusTextBlock"
                                   Margin="0,8,0,0"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <TextBlock x:Name="DevelopmentNoticeTextBlock"
                                   Text="目前处于开发阶段，可能存在不稳定情况！"
                                   HorizontalAlignment="Left"
                                   Foreground="#B45309" />
                        <TextBlock x:Name="VersionTextBlock"
                                   HorizontalAlignment="Right"
                                   Foreground="#6B7280" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
