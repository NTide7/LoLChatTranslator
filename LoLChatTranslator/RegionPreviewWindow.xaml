<Window x:Class="LoLChatTranslator.RegionPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="当前框选范围"
        Icon="Assets/AppIcon.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="#33000000"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Hand"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid>
        <Canvas x:Name="PreviewCanvas">
            <Rectangle x:Name="RegionRectangle"
                       Stroke="#22C55E"
                       StrokeThickness="3"
                       Fill="#3322C55E" />
            <Border x:Name="InstructionBorder"
                    Padding="16,10"
                    Background="#EE111827"
                    CornerRadius="8">
                <TextBlock Text="绿色区域是当前 OCR 聊天框选范围。点击任意位置或按 Esc 关闭。"
                           Foreground="White"
                           FontSize="14" />
            </Border>
        </Canvas>
    </Grid>
</Window>
