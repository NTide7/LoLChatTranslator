<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AssemblyName>LoLChatTranslator</AssemblyName>
    <RootNamespace>LoLChatTranslator</RootNamespace>
    <Product>LOL Chat OCR Translator</Product>
    <AssemblyTitle>LOL Chat OCR Translator</AssemblyTitle>
    <Description>Safe screenshot OCR chat translation helper for League of Legends.</Description>
    <Company>LoLChatTranslator</Company>
    <Authors>LoLChatTranslator</Authors>
    <Version>1.0.1-dev</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <InformationalVersion>1.0.1-dev</InformationalVersion>
    <SatelliteResourceLanguages>zh-Hans;zh-Hant;ja;ko;vi</SatelliteResourceLanguages>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions>.xml</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="champion_aliases.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\lol_chat_normalizer_pack_cn.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\lol_slang_v2.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\chat_channel_aliases.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="OCR\ppocrv5_multilingual.py">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="Installers\python-3.11.9-amd64.exe" Condition="Exists('Installers\python-3.11.9-amd64.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

</Project>
